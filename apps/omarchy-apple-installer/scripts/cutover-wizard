#!/usr/bin/env bash
#
# A wizard — walks a human through a manual procedure step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library — delightful, consistent UX. Identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear — wipe the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" — opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later — it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" — clear the screen, then announce a stage and show progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." — a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." — a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL — open in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser — visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser — visit it manually: $url"
}

# pause "msg" — wait for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" — y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY — current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" — read a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" — like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE — upsert KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE — set a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name — gh not ready; set it later"
}

# set_var NAME VALUE — set a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name — gh not ready; set it later"
}

# finish — clear, then a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# ──────────────────────────────────────────────────────────────────────────
# STAGES — the owner-gated cutover to channel distribution.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=10

APP_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_DIR="$(cd -- "$APP_DIR/../.." && pwd)"
WORK_DIR="${OMARCHY_CUTOVER_WORK:-$HOME/omarchy-cutover}"
ENV_FILE="$WORK_DIR/cutover-state.env"

KEY_SERVICE="omarchy-channel-signing-key"
PUBLIC_BASE="https://downloads.aicodelabs.com.au"
R2_BUCKET="omarchy-releases"
R2_ENDPOINT="https://ab85a8b9d88f084e66bf9d4a8ee5cf66.r2.cloudflarestorage.com"
SOURCE_TAG="v4.0.2-mac.1.19.090426"
OS_TAG="os-v4.0.2-mac.1.20260902"
APP_VERSION="2.0.1"
APP_BUILD="21"
PAYLOAD="omarchy-2026.09.02-aarch64-apple-silicon-asahi-os-package.zip"
ENGINE="installer-v0.9.0-omarchy.14.tar.gz"
METADATA="installer_data.json"
PAYLOAD_SOURCE="$REPO_DIR/../omarchy-iso/release/$PAYLOAD"
SIGN_ID="Developer ID Application: MARCELO DE BARROS ALCANTARA (T2C384FJBD)"
TEAM_ID="T2C384FJBD"
NOTARY_PROFILE="omarchy-notary"

mkdir -p "$WORK_DIR"

run() {
  printf '  %s$%s %s\n' "$DIM" "$RESET" "$*"
  "$@"
}

# The catalog generator digests real files and rejects symlinks, so stage the
# assets as hard links where possible: the payload is 3.6 GB and copying it
# would cost time and disk for nothing.
link_or_copy() {
  rm -f "$2"
  ln "$1" "$2" 2>/dev/null || cp "$1" "$2"
}

r2_env() {
  AWS_ACCESS_KEY_ID=$(security find-generic-password -s omarchy-r2-access-key-id -w)
  AWS_SECRET_ACCESS_KEY=$(security find-generic-password -s omarchy-r2-secret-access-key -w)
  export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
}

# Prints the published size, or nothing when the object is absent. A missing
# object is an expected answer here, not an error, so the failing curl must not
# take the wizard down under set -e.
published_size() {
  curl -fsSLI -H 'Cache-Control: no-cache' "$1" 2>/dev/null |
    awk 'BEGIN{IGNORECASE=1}/^content-length:/{gsub(/\r/,"");print $2}' |
    tail -1 || true
}

banner "Omarchy MX Mac — cutover to channel distribution"

# ── 1 ─────────────────────────────────────────────────────────────────────
stage "Mint the long-lived signing key"
say "This key signs every future release catalog. It is created once."
say "Losing it means every installed app must be replaced, so the backup matters"
say "more than anything else in this wizard."
echo
if security find-generic-password -s "$KEY_SERVICE" >/dev/null 2>&1; then
  note "A key already exists in your keychain under $KEY_SERVICE."
  note "Skipping creation — the wizard never replaces an existing signing key."
  FINGERPRINT=$(xcrun swift "$APP_DIR/scripts/catalog-signing.swift" \
    public-key-keychain "$KEY_SERVICE" "$WORK_DIR/trust-root.ed25519.pub" |
    sed -n 's/^trust_root_fingerprint=//p')
else
  warn "The next step prints the private key once so you can back it up."
  say "Have your password manager open and ready before continuing."
  if ! confirm "Ready to create the key?"; then
    say "Nothing was created. Re-run when you are ready."
    exit 0
  fi
  run xcrun swift "$APP_DIR/scripts/catalog-signing.swift" generate \
    "$WORK_DIR/trust-root.key" "$WORK_DIR/trust-root.ed25519.pub"
  echo
  say "Store BOTH of these in your password manager, in one entry named"
  say "\"Omarchy channel signing key\":"
  echo
  printf '  %sprivate key (base64):%s %s\n' "$BOLD" "$RESET" "$(base64 <"$WORK_DIR/trust-root.key")"
  printf '  %spublic key  (base64):%s %s\n' "$BOLD" "$RESET" "$(base64 <"$WORK_DIR/trust-root.ed25519.pub")"
  echo
  pause "Press Enter once both are saved in your password manager."
  if ! confirm "Confirm the private key is saved somewhere you can recover it?"; then
    say "Stopping. The key file is at $WORK_DIR/trust-root.key — back it up, then re-run."
    exit 1
  fi
  FINGERPRINT=$(xcrun swift "$APP_DIR/scripts/catalog-signing.swift" \
    import-keychain "$WORK_DIR/trust-root.key" "$KEY_SERVICE" |
    sed -n 's/^trust_root_fingerprint=//p')
  run rm -P "$WORK_DIR/trust-root.key"
  say "The private key is now only in your keychain and your password manager."
  warn "Clear your terminal scrollback now if it is saved to disk."
fi
write_env TRUST_ROOT_FINGERPRINT "$FINGERPRINT"
say "Fingerprint: $FINGERPRINT"
pause

# ── 2 ─────────────────────────────────────────────────────────────────────
stage "Commit the release identity"
say "The app is built against these two files. They change only if the key is"
say "ever rotated, so they belong in the repository."
run cp "$WORK_DIR/trust-root.ed25519.pub" "$APP_DIR/Release/trust-root.ed25519.pub"
if [[ -f "$APP_DIR/Release/release.json" ]]; then
  note "Release/release.json already exists — leaving it as it is."
else
  run "$APP_DIR/scripts/make-release-descriptor" \
    --public-key "$APP_DIR/Release/trust-root.ed25519.pub" \
    --base-url "$PUBLIC_BASE" \
    --output "$APP_DIR/Release/release.json"
fi
echo
say "Review and commit these with the rest of the change set:"
step "cd $REPO_DIR && git add -A && git status"
step "git commit"
note "Nothing is pushed by this wizard."
pause "Press Enter when you have reviewed the files."

# ── 3 ─────────────────────────────────────────────────────────────────────
stage "Copy the published release set to the new tag"
say "The catalog must name artifacts under its own release prefix, so the three"
say "release files need to exist under releases/$OS_TAG/."
echo
say "Anything already there at the right size is left alone: the bucket locks"
say "published objects, and re-writing one would fail on that lock."
echo

# Uploads come from the local copies rather than a bucket-to-bucket copy. R2
# implements neither GetObjectTagging nor the CopyObject tagging directive the
# AWS CLI sends, so a server-side copy cannot be made to work; a plain upload
# has no such problem.
declare -a MISSING_ASSETS=()
for entry in "$PAYLOAD:$PAYLOAD_SOURCE:3638729568" \
             "$ENGINE:$APP_DIR/Engine/artifacts/$ENGINE:17917578" \
             "$METADATA:$APP_DIR/Engine/$METADATA:1003"; do
  asset=${entry%%:*}
  rest=${entry#*:}
  local_path=${rest%:*}
  expected=${rest##*:}
  actual=$(published_size "$PUBLIC_BASE/releases/$OS_TAG/$asset")
  if [[ $actual == "$expected" ]]; then
    printf '  %s✓%s %s already published (%s bytes)\n' "$GREEN" "$RESET" "$asset" "$actual"
  elif [[ -n $actual ]]; then
    warn "$asset is published at $actual bytes but should be $expected"
    warn "The bucket locks published objects, so this needs a new tag. Stop here."
    exit 1
  else
    printf '  %s•%s %s is missing and will be uploaded\n' "$BLUE" "$RESET" "$asset"
    MISSING_ASSETS+=("$asset:$local_path")
  fi
done
echo
if (( ${#MISSING_ASSETS[@]} == 0 )); then
  say "All three are already published. Nothing to do."
  pause
else
  for entry in "${MISSING_ASSETS[@]}"; do
    asset=${entry%%:*}
    local_path=${entry#*:}
    size=$(wc -c <"$local_path" | tr -d " ")
    say "$asset — $size bytes from $local_path"
  done
  echo
  if confirm "Upload the missing file(s)?"; then
    r2_env
    for entry in "${MISSING_ASSETS[@]}"; do
      asset=${entry%%:*}
      local_path=${entry#*:}
      run aws s3 cp "$local_path" "s3://$R2_BUCKET/releases/$OS_TAG/$asset" \
        --endpoint-url "$R2_ENDPOINT" --region auto --only-show-errors
    done
    echo
    for asset in "$PAYLOAD" "$ENGINE" "$METADATA"; do
      size=$(published_size "$PUBLIC_BASE/releases/$OS_TAG/$asset")
      say "$asset -> ${size:-NOT PUBLISHED}"
    done
    pause "Press Enter if all three report a size."
  else
    say "Skipped. The catalog stage will fail until all three exist."
    pause
  fi
fi

# ── 4 ─────────────────────────────────────────────────────────────────────
stage "Build and sign the first channel catalog"
mkdir -p "$WORK_DIR/assets" "$WORK_DIR/catalog"

# A published catalog is immutable and already signed. Regenerating one would
# only mint a different sequence that the locked bucket refuses to store, so a
# re-run reuses what is already there.
PUBLISHED_CATALOG=$(published_size "$PUBLIC_BASE/releases/$OS_TAG/catalog.signed.json")

if [[ -n $PUBLISHED_CATALOG ]]; then
  printf '  %s✓%s a signed catalog is already published for %s\n' "$GREEN" "$RESET" "$OS_TAG"
  run curl -fsSL -H 'Cache-Control: no-cache' \
    "$PUBLIC_BASE/releases/$OS_TAG/catalog.signed.json" \
    -o "$WORK_DIR/catalog/catalog.signed.json"
  python3 - "$WORK_DIR/catalog/catalog.signed.json" \
    "$WORK_DIR/catalog/catalog.json" "$WORK_DIR/catalog/catalog.json.sig" <<'PYDECODE'
import base64
import json
import sys

envelope, catalog, signature = sys.argv[1:4]
document = json.load(open(envelope, encoding="utf-8"))
open(catalog, "wb").write(base64.b64decode(document["catalog"]))
open(signature, "wb").write(base64.b64decode(document["signature"]))
print("  sequence:", json.load(open(catalog, encoding="utf-8"))["sequence"])
PYDECODE
  run xcrun swift "$APP_DIR/scripts/catalog-signing.swift" verify \
    "$APP_DIR/Release/trust-root.ed25519.pub" \
    "$WORK_DIR/catalog/catalog.json" "$WORK_DIR/catalog/catalog.json.sig"
  say "Reusing it. Nothing is regenerated and nothing is re-signed."
  pause
else
say "This digests the local copies of the same three files, so the catalog and"
say "the published bytes must agree exactly."
run link_or_copy "$PAYLOAD_SOURCE" "$WORK_DIR/assets/$PAYLOAD"
run link_or_copy "$APP_DIR/Engine/artifacts/$ENGINE" "$WORK_DIR/assets/$ENGINE"
run link_or_copy "$APP_DIR/Engine/$METADATA" "$WORK_DIR/assets/$METADATA"

python3 - "$APP_DIR/scripts/release-inputs.template.json" "$WORK_DIR/inputs.json" <<'PY'
import json, sys
template, output = sys.argv[1:3]
document = json.load(open(template))
document["evidence_revision"] = "4.0.2-mac.1.20260902"
json.dump(document, open(output, "w"), indent=2)
PY
say "Inputs written to $WORK_DIR/inputs.json"

run python3 "$APP_DIR/scripts/make-unsigned-catalog.py" \
  --base-url "$PUBLIC_BASE/releases/$OS_TAG" \
  --assets-dir "$WORK_DIR/assets" \
  --inputs "$WORK_DIR/inputs.json" \
  --output "$WORK_DIR/catalog/catalog.json"
echo
say "Signing with the keychain key. macOS may ask for your login password."
run xcrun swift "$APP_DIR/scripts/catalog-signing.swift" sign-keychain \
  "$KEY_SERVICE" "$WORK_DIR/catalog/catalog.json" "$WORK_DIR/catalog/catalog.json.sig"
run xcrun swift "$APP_DIR/scripts/catalog-signing.swift" verify \
  "$APP_DIR/Release/trust-root.ed25519.pub" \
  "$WORK_DIR/catalog/catalog.json" "$WORK_DIR/catalog/catalog.json.sig"
run "$APP_DIR/scripts/publish-channels" envelope \
  --catalog "$WORK_DIR/catalog/catalog.json" \
  --signature "$WORK_DIR/catalog/catalog.json.sig" \
  --output "$WORK_DIR/catalog/catalog.signed.json"
  pause
fi

# ── 5 ─────────────────────────────────────────────────────────────────────
stage "Publish the catalog to its immutable release prefix"
say "This writes three small files under releases/$OS_TAG/."
if [[ -n $PUBLISHED_CATALOG ]]; then
  printf '  %s✓%s already published — nothing to do\n' "$GREEN" "$RESET"
elif confirm "Publish the catalog objects?"; then
  r2_env
  for asset in catalog.json catalog.json.sig catalog.signed.json; do
    run aws s3 cp "$WORK_DIR/catalog/$asset" \
      "s3://$R2_BUCKET/releases/$OS_TAG/$asset" \
      --endpoint-url "$R2_ENDPOINT" --region auto --only-show-errors
  done
  say "Published. Verifying it reads back:"
  run curl -fsSLI -o /dev/null -w '  catalog.signed.json HTTP %{http_code}\n' \
    "$PUBLIC_BASE/releases/$OS_TAG/catalog.signed.json"
fi
write_env OS_TAG "$OS_TAG"
pause

# ── 6 ─────────────────────────────────────────────────────────────────────
stage "Build and notarize the app"
BUILT_APP="$WORK_DIR/app/Omarchy MX Mac Installer.app"

# Notarization is slow and costs an Apple round trip, so an app that is already
# built, stapled and at the right version is reused rather than made again.
app_is_ready() {
  [[ -d $BUILT_APP ]] || return 1
  local version
  version=$(plutil -extract CFBundleShortVersionString raw -o - \
    "$BUILT_APP/Contents/Info.plist" 2>/dev/null) || return 1
  [[ $version == "$APP_VERSION" ]] || return 1
  xcrun stapler validate "$BUILT_APP" >/dev/null 2>&1
}

if app_is_ready; then
  printf '  %s✓%s %s is already built, notarized and stapled\n' "$GREEN" "$RESET" "$APP_VERSION"
  note "Delete $WORK_DIR/app to force a rebuild."
else
  say "Version $APP_VERSION, build $APP_BUILD. This takes a few minutes and"
  say "notarization waits on Apple."
  rm -rf "$WORK_DIR/app"
  run env OMARCHY_APP_VERSION="$APP_VERSION" OMARCHY_APP_BUILD_NUMBER="$APP_BUILD" \
    OMARCHY_APP_SIGNING_IDENTITY="$SIGN_ID" OMARCHY_TEAM_ID="$TEAM_ID" \
    "$APP_DIR/Packaging/build-app.sh" "$APP_DIR/Release" "$WORK_DIR/app"
  echo
  run env OMARCHY_NOTARY_PROFILE="$NOTARY_PROFILE" \
    "$APP_DIR/Packaging/notarize-app.sh" "$BUILT_APP"
fi
pause

# ── 7 ─────────────────────────────────────────────────────────────────────
stage "Build, notarize and staple the package"
PKG="$WORK_DIR/Omarchy-MX-Mac-Installer-$APP_VERSION.pkg"
rm -f "$PKG"
# No --plist: the builder derives the daemon plist from the one the app embeds,
# rewriting its bundle-relative program into an absolute path under
# /Applications and carrying the real client requirement. The repo template
# still holds the REPLACED_DURING_PACKAGING placeholder, and passing it is what
# shipped the crash-looping helper in builds 1.11 through 1.18.
run "$APP_DIR/Packaging/pkg/build-pkg.sh" \
  --app "$BUILT_APP" \
  --version "$APP_VERSION" --out "$PKG"
echo
say "Submitting to Apple. This usually takes a few minutes."
run xcrun notarytool submit "$PKG" --keychain-profile "$NOTARY_PROFILE" --wait
run xcrun stapler staple "$PKG"
run spctl -a -vv -t install "$PKG"
write_env PKG_PATH "$PKG"
pause

# ── 8 ─────────────────────────────────────────────────────────────────────
stage "Publish to the rc channel"
say "Users are untouched by this. Only a Mac switched to rc will see it."
if confirm "Publish the installer and the catalog to rc?"; then
  r2_env
  run env OMARCHY_PUBLISH_ASSUME_YES="installer-v$APP_VERSION" \
    "$APP_DIR/scripts/publish-channels" app-publish \
    --pkg "$PKG" --version "$APP_VERSION" --to rc
  echo
  run env OMARCHY_PUBLISH_ASSUME_YES="$OS_TAG" \
    "$APP_DIR/scripts/publish-channels" os-promote \
    --tag "$OS_TAG" --to rc --minimum-sequence 1788321264
fi
pause

# ── 9 ─────────────────────────────────────────────────────────────────────
stage "Test on the M1"
say "This is the only step that proves the release actually installs."
echo
step "On the M1, run the preclean if Omarchy is still installed:"
note "  bash $APP_DIR/scripts/preclean-m1.sh        (dry run first)"
note "  bash $APP_DIR/scripts/preclean-m1.sh --confirm"
step "Download the BETA package on the M1:"
note "  $PUBLIC_BASE/installer/rc/Omarchy-MX-Mac-Installer.pkg"
step "Confirm the saved file is named \"Omarchy MX Mac Installer.pkg\"."
step "Check it before opening:"
note "  spctl -a -vv -t install ~/Downloads/\"Omarchy MX Mac Installer.pkg\""
step "Install it, then confirm the receipt and the helper:"
note "  pkgutil --pkg-info com.omarchy.mx.installer.pkg     (expect $APP_VERSION)"
note "  sudo launchctl print system/com.omarchy.mx.installer.helper | head"
step "Switch the app to rc: menu bar > Release Channel > RC."
step "Confirm the BETA banner and badge appear, and the catalog verifies."
step "Complete an install, boot Omarchy, then run: omarchy debug apple"
step "Switch back to Stable and confirm it is not blocked as a rollback."
echo
warn "The package version goes from 4.0.2-mac.1.19.090426 down to $APP_VERSION"
warn "under the same identifier. Confirm pkgutil reports $APP_VERSION."
echo
if ! confirm "Did the M1 install succeed end to end?"; then
  say "Stopping before stable. Nothing users can reach has changed."
  exit 1
fi
pause

# ── 10 ────────────────────────────────────────────────────────────────────
stage "Promote to stable"
say "This is the moment the public download changes. The same bytes you just"
say "tested on rc are copied to stable; nothing is rebuilt."
if confirm "Promote the installer and the catalog to stable?"; then
  r2_env
  run env OMARCHY_PUBLISH_ASSUME_YES="installer-v$APP_VERSION" \
    "$APP_DIR/scripts/publish-channels" app-publish \
    --pkg "$PKG" --version "$APP_VERSION" --to stable
  echo
  run env OMARCHY_PUBLISH_ASSUME_YES="$OS_TAG" \
    "$APP_DIR/scripts/publish-channels" os-promote \
    --tag "$OS_TAG" --to stable --minimum-sequence 1788321264
  echo
  run "$APP_DIR/scripts/publish-channels" channel-status --channel all
  echo
  say "The public download now serves $APP_VERSION:"
  run curl -fsSLI -o /dev/null \
    -w '  HTTP %{http_code}  %{size_download} bytes\n' \
    "$PUBLIC_BASE/installer/stable/Omarchy-MX-Mac-Installer.pkg"
fi

finish
