#!/bin/bash

# omarchy:summary=Run pending Omarchy migrations.
# omarchy:args=[--pending]

set -euo pipefail

mode="run"

usage() {
  echo "Usage: omarchy-migrate [--pending]"
}

while (($#)); do
  case "$1" in
    --pending|--check)
      mode="pending"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
STATE_DIR="${OMARCHY_MIGRATION_STATE:-$HOME/.local/state/omarchy/migrations}"
MIGRATIONS_DIR="$OMARCHY_PATH/migrations"

migration_entries() {
  [[ -d $MIGRATIONS_DIR ]] || return 0

  local file filename

  for file in "$MIGRATIONS_DIR"/*.sh; do
    [[ -f $file ]] || continue
    filename=$(basename "$file")
    printf '%s\t%s\t%s\n' "$filename" "$file" "$STATE_DIR/$filename"
  done
}

migration_skip_marker() {
  printf '%s.skipped\n' "$1"
}

valid_skip_marker() {
  local skip_marker="$1"
  local timestamp disposition reason extra

  [[ -f $skip_marker ]] || return 1
  IFS=$'\t' read -r timestamp disposition reason extra <"$skip_marker" || return 1
  [[ -n $timestamp && ( $disposition == "handled" || $disposition == "skipped" ) && -n $reason && -z $extra ]]
}

migration_settled() {
  local marker="$1"
  local skip_marker

  [[ -f $marker ]] && return 0
  (( asahi )) || return 1
  skip_marker=$(migration_skip_marker "$marker")
  valid_skip_marker "$skip_marker"
}

apple_silicon() {
  if [[ -x $OMARCHY_PATH/bin/omarchy-hw-apple-silicon ]]; then
    "$OMARCHY_PATH/bin/omarchy-hw-apple-silicon"
  else
    [[ $(uname -m) == "aarch64" ]] && grep -aq 'apple,' /proc/device-tree/compatible 2>/dev/null
  fi
}

asahi_migration_disposition() {
  case "$1" in
    1778623107.sh) printf 'handled\tmpv-mpris installed by the Asahi Quattro package transition\n' ;;
    1780057136.sh|1780294774.sh|1780517689.sh|1781587663.sh|1782049344.sh|1784479832.sh|1784508556.sh|1784521870.sh|1784568652.sh|1784763917.sh|1784767406.sh|1784809451.sh|1784818437.sh|1784849592.sh|1784909971.sh|1784960000.sh|1784970000.sh|1784989000.sh|1785002349.sh|1785095882.sh|1785101000.sh|1785166747.sh|1785167800.sh|1785189600.sh|1785344985.sh|1785351479.sh|1785511354.sh|1785543725.sh|1785591762.sh|1785608166.sh|1785608251.sh|1785617047.sh|1785633225.sh|1785846769.sh|1786098807.sh|1786099804.sh|1786181929.sh|1786183928.sh|1786278735.sh|1786279107.sh|1786380259.sh|1786386460.sh|1786447584.sh|1786451567.sh|1786517850.sh|1786539345.sh|1786549201.sh|1786643346.sh|1787387209.sh) printf 'run\treviewed as architecture-neutral\n' ;;
    1780739888.sh) printf 'handled\tdua installed and dust retired by the Quattro transition\n' ;;
    1781043107.sh) printf 'handled\ttheme state moved by the Quattro user transition\n' ;;
    1781063758.sh) printf 'handled\tHyprland configuration replaced by the Quattro user transition\n' ;;
    1781158082.sh) printf 'handled\ttheme links rebuilt by the Quattro user transition\n' ;;
    1781286586.sh) printf 'run\treviewed: tensaku is built for aarch64 in the Apple Silicon package repository\n' ;;
    1781485962.sh) printf 'handled\tHyprland defaults reconciled by the Quattro user transition\n' ;;
    1781793381.sh) printf 'handled\tudiskie installed by the Asahi Quattro package transition\n' ;;
    1781984677.sh) printf 'skipped\tSnapper and Limine repair is not applicable to Asahi\n' ;;
    1782002156.sh) printf 'handled\tnetwork transition completed with the Asahi iwd backend\n' ;;
    1784401744.sh) printf 'handled\tAsahi hardware and Vulkan ownership handled by the Quattro transition\n' ;;
    1784476564.sh) printf 'skipped\tLimine must not rebuild the Asahi initramfs\n' ;;
    1784510887.sh) printf 'skipped\tunsupported AUR browser replacement on Asahi\n' ;;
    1784672586.sh) printf 'handled\tvalidated quickshell-git package installed by the Quattro transition\n' ;;
    1784914435.sh) printf 'handled\tpackaged NetworkManager policy installed by the Quattro transition\n' ;;
    1784917531.sh) printf 'skipped\tLimine kernel and initramfs repair is not applicable to Asahi\n' ;;
    1784809452.sh) printf 'skipped\tSnapper timeline cleanup is not applicable to Asahi\n' ;;
    1784961000.sh|1785013000.sh) printf 'skipped\tzram tuning is held until validated on Asahi\n' ;;
    1785090473.sh) printf 'skipped\tfingerprint hardware is unsupported on this Apple Silicon path\n' ;;
    1785273276.sh) printf 'skipped\tT2 Limine and mkinitcpio repair is not applicable to Apple Silicon\n' ;;
    1785424256.sh) printf 'skipped\tsystemd-oomd reclaim tuning is held until validated on Asahi\n' ;;
    1785637426.sh) printf 'run\treviewed: omacalc is built for aarch64 in the Apple Silicon package repository\n' ;;
    1785944594.sh|1786137597.sh) printf 'skipped\tT2 Limine and mkinitcpio repair is not applicable to Apple Silicon\n' ;;
    1786273938.sh) printf 'run\treviewed: herdr is built for aarch64 in the Apple Silicon package repository\n' ;;
    1786355450.sh) printf 'run\treviewed: ttfx is built for aarch64 in the Apple Silicon package repository\n' ;;
    1786391100.sh) printf 'skipped\tIntel Mac Broadcom firmware quirk breaks Apple Silicon Wi-Fi\n' ;;
    1786482992.sh) printf 'skipped\tLimine boot image repair is not applicable to Asahi\n' ;;
    1786567036.sh) printf 'skipped\tNetworkManager remains on the validated Asahi iwd backend\n' ;;
    1786605598.sh) printf 'skipped\tNVIDIA Limine initramfs repair is not applicable to Asahi\n' ;;
    1786782461.sh) printf 'run\treviewed as architecture-neutral\n' ;;
    1786922691.sh) printf 'run\treviewed as architecture-neutral\n' ;;
    1786952219.sh) printf 'skipped\tmise-bin is unavailable in the Apple Silicon package repositories\n' ;;
    1787133200.sh) printf 'run\treviewed as architecture-neutral\n' ;;
    1787231692.sh) printf 'run\treviewed as architecture-neutral\n' ;;
    1787399318.sh) printf 'skipped\tvalidated quickshell-git remains in the Apple Silicon bundle\n' ;;
    1787481315.sh) printf 'run\treviewed as architecture-neutral\n' ;;
    1787491150.sh) printf 'run\treviewed as architecture-neutral\n' ;;
    1787494718.sh) printf 'run\treviewed FIDO2 authfile ownership repair\n' ;;
    1787497040.sh) printf 'run\tApple HID early-load gates itself to Apple Silicon hardware\n' ;;
    1787552067.sh) printf 'run\treviewed Apple Silicon audio package repair\n' ;;
    1787552167.sh) printf 'run\treviewed as architecture-neutral\n' ;;
    1787560726.sh) printf 'run\treviewed Apple Silicon package repository setup\n' ;;
    1787568759.sh) printf 'run\treviewed as architecture-neutral\n' ;;
    1787580187.sh) printf 'run\treviewed architecture-neutral Docker group hardening\n' ;;
    1787618700.sh) printf 'run\treviewed safe Hyprland input-device state migration\n' ;;
    1787515927.sh) printf 'run\treviewed architecture-neutral browser policy hardening\n' ;;
    1787589206.sh) printf 'run\treviewed no-op: the Apple Silicon omarchy repository already requires signed packages\n' ;;
    1787691200.sh) printf 'run\treviewed architecture-neutral Chromium first-run seed\n' ;;
    1787815267.sh) printf 'run\treviewed CUPS privilege separation; cups-pk-helper resolves in the Asahi channels\n' ;;
    1787865477.sh) printf 'run\treviewed input-group hardening; Apple input devices do not use the blanket grant\n' ;;
    1788009111.sh) printf 'run\treviewed printer-discovery removal; self-gating package drop\n' ;;
    1788025225.sh) printf 'run\treviewed architecture-neutral retired-installer artifact removal\n' ;;
    1788102906.sh) printf 'run\treviewed architecture-neutral XCompose and legacy udev rule repair\n' ;;
    1788112314.sh) printf 'run\treviewed no-op: Asahi installs do not use the rc mirror pairing\n' ;;
    1788124236.sh) printf 'run\treviewed sshd hardening; self-gating on an enabled or active sshd\n' ;;
    1788345489.sh) printf 'run\tApple Silicon speaker pop fix gates itself to Apple Silicon hardware\n' ;;
    1788486400.sh) printf 'run\treviewed default package parity install; every package is built for aarch64\n' ;;
    *) return 1 ;;
  esac
}

record_skipped_migration() {
  local marker="$1"
  local disposition="$2"
  local reason="$3"
  local skip_marker tmp

  skip_marker=$(migration_skip_marker "$marker")
  mkdir -p "$(dirname "$skip_marker")"
  tmp="$skip_marker.tmp.$$"
  printf '%s\t%s\t%s\n' "$(date --iso-8601=seconds)" "$disposition" "$reason" >"$tmp"
  mv "$tmp" "$skip_marker"
}

pending_migrations() {
  local name file marker

  while IFS=$'\t' read -r name file marker; do
    [[ -n $name ]] || continue
    if ! migration_settled "$marker"; then
      printf '%s\n' "$name"
    fi
  done < <(migration_entries)
}

asahi=0
apple_silicon && asahi=1

if [[ $mode == "pending" ]]; then
  pending_output=$(pending_migrations)
  if [[ -n $pending_output ]]; then
    printf '%s\n' "$pending_output"
    exit 0
  else
    exit 1
  fi
fi

wait_for_pacman_transaction() {
  local lock_file=/var/lib/pacman/db.lck

  [[ -e $lock_file ]] || return 0
  echo "Waiting for pacman transaction to finish before running Omarchy migrations..."

  for _ in {1..900}; do
    [[ -e $lock_file ]] || return 0
    sleep 1
  done

  echo "Pacman transaction is still running; Omarchy migrations will retry on next login."
  exit 0
}

wait_for_pacman_transaction

mkdir -p "$STATE_DIR"
[[ -d $MIGRATIONS_DIR ]] || exit 0

while IFS=$'\t' read -r name file marker <&3; do
  [[ -n $name ]] || continue

  migration_settled "$marker" && continue

  if (( asahi )); then
    disposition_record=""
    if ! disposition_record=$(asahi_migration_disposition "$name"); then
      echo "Migration '$name' has not been reviewed for Apple Silicon; leaving it pending." >&2
      exit 1
    fi
    IFS=$'\t' read -r disposition reason <<<"$disposition_record"
    if [[ $disposition != "run" ]]; then
      echo "Settling migration (${name%.sh}): $disposition - $reason"
      record_skipped_migration "$marker" "$disposition" "$reason"
      continue
    fi
  fi

  echo -e "\e[32m\nRunning migration (${name%.sh})\e[0m"
  OMARCHY_PATH="$OMARCHY_PATH" bash -euo pipefail "$file" 3<&-
  mkdir -p "$(dirname "$marker")"
  touch "$marker"
done 3< <(migration_entries)

# Clear a login-time notification the user left sitting there and then resolved
# by running migrations some other way. The substring matches both the current
# and legacy notification titles.
omarchy-notification-dismiss "Omarchy Migrations" >/dev/null 2>&1 || true
